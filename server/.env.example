# Copy to .env and adjust. Loaded by Node itself via --env-file-if-exists=.env
# in the npm scripts — no dotenv package involved.

PORT=4000

# Comma-separated list of allowed browser origins.
# In development, private-LAN origins (192.168.x.x, 10.x.x.x, ...) are also
# accepted automatically so other devices on the Wi-Fi can join.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Halt the game when someone wins (set false to keep playing for 2nd/3rd place).
STOP_ON_WIN=true

# true  — ANY wrong mark on the card invalidates a bingo claim.
# false — only the completed line is judged, so a stray tap elsewhere is forgiven.
STRICT_MARKS=true

# Required as the x-admin-key header on /api/admin/* and /api/history/*.
# This also gates the answer key and the claim audit trail. CHANGE THIS.
ADMIN_KEY=dev-admin-key

# Human login for the /admin page (username + password -> session token).
# Leave both empty to disable the login form entirely.
ADMIN_USER=your-admin-username
ADMIN_PASSWORD=your-admin-password

# MongoDB Atlas. Keep the literal <PASSWORD> token here — the server swaps it for
# DATABASE_PASSWORD at startup, so the secret never lives in the URI itself.
# NEVER put the real password in this file: .env.example IS committed to git.
DATABASE=mongodb+srv://<user>:<PASSWORD>@<cluster>.mongodb.net/bingo?retryWrites=true&w=majority
DATABASE_PASSWORD=your-atlas-password

# Databases this app refuses to write to, whatever the URI says. Guards against a
# copy-pasted URI pointing at another application's data.
FORBIDDEN_DATABASES=yitav,test,admin,local

# A round older than this is never resumed after a restart (default 15 minutes).
ROUND_RESUME_MAX_AGE_MS=900000
